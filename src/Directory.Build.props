<Project>
  <PropertyGroup>
    <!-- Both self-contained apps must include the October 2026 runtime fixes. -->
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
