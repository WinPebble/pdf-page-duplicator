<Window x:Class="WinPebble.PdfPageDuplicator.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Page Duplicator — WinPebble"
        Icon="Resources/WinPebble-Pebble-Mark-512.png"
        Width="1040" Height="720" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,4,18,4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="PDF Page Duplicator" FontSize="26" FontWeight="Bold" Foreground="#192C43"/>
      <TextBlock Text="Duplicate each PDF page on one sheet — 2-up or 4-up."
                 Margin="0,5,0,0" Foreground="#586779"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,20,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="19" BorderBrush="#E0E6EF" BorderThickness="1">
            <StackPanel x:Name="OptionsPanel">
              <TextBlock Text="Output settings" FontSize="18" FontWeight="SemiBold" Foreground="#192C43"/>
              <Button x:Name="BrowseButton" Content="Choose PDF…" Click="Browse_Click" Margin="0,10,0,8"/>
              <TextBlock x:Name="FileLabel" Text="No PDF selected" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#536478"/>
              <Separator Margin="0,8,0,8"/>
              <TextBlock Text="Paper orientation" FontWeight="SemiBold" Foreground="#192C43"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PortraitOption" GroupName="Orientation" Content="Portrait" IsChecked="True" Checked="SettingsChanged"/>
                <RadioButton x:Name="LandscapeOption" GroupName="Orientation" Content="Landscape" Checked="SettingsChanged"/>
              </StackPanel>
              <Separator Margin="0,8,0,8"/>
              <TextBlock Text="Copies per page" FontWeight="SemiBold" Foreground="#192C43"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TwoOption" GroupName="Copies" Content="2 copies" IsChecked="True" Checked="SettingsChanged"/>
                <RadioButton x:Name="FourOption" GroupName="Copies" Content="4 copies" Checked="SettingsChanged"/>
              </StackPanel>
              <Border Background="#EFF4FA" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                <TextBlock Text="Same paper size. Copies scale proportionally. One output page per input page."
                           TextWrapping="Wrap" Foreground="#42556D" FontSize="12"/>
              </Border>
            </StackPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="14" Padding="16">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Original page" FontSize="17" FontWeight="SemiBold" Foreground="#192C43"/>
              <TextBlock x:Name="OriginalSizeLabel" Text="Select a PDF to preview" TextWrapping="Wrap" FontSize="12" Foreground="#617087" Margin="0,6,0,12"/>
            </StackPanel>
            <Border Background="#EFF3F8" CornerRadius="10" ClipToBounds="True">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                <Canvas x:Name="OriginalCanvas" Width="275" Height="350"/>
              </Viewbox>
            </Border>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="14" Padding="16">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Output preview" FontSize="17" FontWeight="SemiBold" Foreground="#192C43"/>
              <TextBlock x:Name="OutputSizeLabel" Text="2 copies • Portrait" TextWrapping="Wrap" FontSize="12" Foreground="#617087" Margin="0,6,0,12"/>
            </StackPanel>
            <Border Background="#EFF3F8" CornerRadius="10" ClipToBounds="True">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="4">
                <Canvas x:Name="OutputCanvas" Width="275" Height="350"/>
              </Viewbox>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid MinHeight="56">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Foreground="#596778" TextTrimming="CharacterEllipsis" FontSize="12"/>
          <Grid x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressLabel" Grid.Column="1" Text="0%" HorizontalAlignment="Right" FontSize="12"/>
          </Grid>
        </StackPanel>
        <Button x:Name="GenerateButton" Grid.Column="2" Content="Create PDF" Click="Generate_Click" IsEnabled="False"
                Background="#245DB3" Foreground="White" BorderThickness="0" Padding="24,12" MinWidth="150" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Grid.Row="1" Margin="0,12,0,0"
               Text="WinPebble — Local processing. No PDF content is shown in the preview."
               Foreground="#687789" FontSize="12"/>
    </Grid>
  </Grid>
</Window>
