<Window x:Class="WinPebble.PdfPageDuplicator.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Page Duplicator — WinPebble"
        Width="1040" Height="680" MinWidth="940" MinHeight="630"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,8,0,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="PDF Page Duplicator" FontSize="26" FontWeight="Bold" Foreground="#192C43"/>
      <TextBlock Text="Duplicate each PDF page on one sheet — 2-up or 4-up."
                 Margin="0,5,0,0" Foreground="#586779"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,20,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="19" BorderBrush="#E0E6EF" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Output settings" FontSize="18" FontWeight="SemiBold" Foreground="#192C43"/>
          <Button x:Name="BrowseButton" Content="Choose PDF…" Click="Browse_Click" Margin="0,17,0,9"/>
          <TextBlock x:Name="FileLabel" Text="No PDF selected" TextWrapping="Wrap" FontSize="12" Foreground="#536478"/>
          <Separator Margin="0,16,0,14"/>
          <TextBlock Text="Paper orientation" FontWeight="SemiBold" Foreground="#192C43"/>
          <RadioButton x:Name="PortraitOption" GroupName="Orientation" Content="Portrait (vertical)" IsChecked="True" Checked="SettingsChanged"/>
          <RadioButton x:Name="LandscapeOption" GroupName="Orientation" Content="Landscape (horizontal)" Checked="SettingsChanged"/>
          <Separator Margin="0,11,0,14"/>
          <TextBlock Text="Copies per page" FontWeight="SemiBold" Foreground="#192C43"/>
          <RadioButton x:Name="TwoOption" GroupName="Copies" Content="2 copies" IsChecked="True" Checked="SettingsChanged"/>
          <RadioButton x:Name="FourOption" GroupName="Copies" Content="4 copies" Checked="SettingsChanged"/>
          <Border Background="#EFF4FA" CornerRadius="8" Padding="12" Margin="0,15,0,15">
            <TextBlock Text="Paper size stays the same. Copies are scaled without distortion. Each input page produces one output page."
                       TextWrapping="Wrap" Foreground="#42556D" FontSize="12"/>
          </Border>
          <Button x:Name="GenerateButton" Content="Create PDF" Click="Generate_Click" IsEnabled="False"
                  Background="#245DB3" Foreground="White" BorderThickness="0" Padding="18,12"/>
          <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#596778" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="14" Padding="16">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Original page" FontSize="17" FontWeight="SemiBold" Foreground="#192C43"/>
              <TextBlock x:Name="OriginalSizeLabel" Text="Select a PDF to preview" FontSize="12" Foreground="#617087" Margin="0,6,0,12"/>
            </StackPanel>
            <Border Background="#EFF3F8" CornerRadius="10" ClipToBounds="True">
              <Canvas x:Name="OriginalCanvas" Width="275" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="14" Padding="16">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Output preview" FontSize="17" FontWeight="SemiBold" Foreground="#192C43"/>
              <TextBlock x:Name="OutputSizeLabel" Text="2 copies • Portrait" FontSize="12" Foreground="#617087" Margin="0,6,0,12"/>
            </StackPanel>
            <Border Background="#EFF3F8" CornerRadius="10" ClipToBounds="True">
              <Canvas x:Name="OutputCanvas" Width="275" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2"
               Text="WinPebble — Local processing. No PDF content is shown in the preview."
               Foreground="#687789" FontSize="12"/>
  </Grid>
</Window>
